# --- LLM providers (Llama models, one per task = separate rate-limit buckets) ---
# Groq:      ReAct agent (best tool-calling)  https://console.groq.com/keys
GROQ_API_KEY=
# Cerebras:  reply drafting                    https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
# SambaNova: summarization                     https://cloud.sambanova.ai/
SAMBANOVA_API_KEY=

# Optional model overrides (defaults are free-tier friendly).
# ASSISTANT_MODEL=llama-3.3-70b-versatile
# CEREBRAS_DRAFT_MODEL=llama-3.3-70b
# SAMBANOVA_SUMMARY_MODEL=Meta-Llama-3.1-8B-Instruct

# --- Slack ---
# Easiest path for local dev: paste a User OAuth token (xoxp-) or Bot token (xoxb-)
# from https://api.slack.com/apps and skip the OAuth flow entirely.
# The app will read this on startup and seed the database.
SLACK_TOKEN=

# Optional: full OAuth flow (needed if you'll distribute the app or rotate tokens)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:8000/auth/slack/callback

# --- App ---
DATABASE_URL=sqlite:///./inbox.db
FRONTEND_ORIGIN=http://localhost:5173
SLACK_POLL_INTERVAL_SECONDS=30
